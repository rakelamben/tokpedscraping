# Token bot Telegram dari @BotFather
BOT_TOKEN=

# Chat ID Anda (admin) untuk monitoring server
ADMIN_CHAT_ID=

# Konfigurasi Scraping
HEADLESS=true
DEFAULT_PAGES=2
JEDA_MIN=2.5
JEDA_MAX=4.5

# Kata kunci bawaan jika dijalankan tanpa argumen (pisahkan dengan koma)
DEFAULT_KEYWORDS=iphone 15,keyboard mechanical,tws anc

# Jadwal pengiriman laporan otomatis harian (WIB)
JAM_JADWAL=08:00
